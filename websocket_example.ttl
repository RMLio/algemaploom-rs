@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix td: <https://www.w3.org/2019/wot/td#> .
@prefix hctl: <https://www.w3.org/2019/wot/hypermedia#> .
@prefix ex: <http://example.com/> .

ex:WebSocketMapping a rr:TriplesMap;
    rml:logicalSource [
        rml:source [
            a td:Thing;
            td:hasPropertyAffordance [
                td:hasForm [
                    hctl:hasTarget "ws://localhost:1234/sensor-data";
                    hctl:forContentType "application/json";
                    hctl:forSubProtocol "mqtt"
                ]
            ]
        ];
        rml:referenceFormulation ql:JSONPath;
        rml:iterator "$.sensors[*]"
    ];
    
    rr:subjectMap [
        rr:template "http://example.com/sensor/{id}";
        rr:class ex:Sensor
    ];
    
    rr:predicateObjectMap [
        rr:predicate ex:sensorId;
        rr:objectMap [
            rml:reference "id"
        ]
    ];
    
    rr:predicateObjectMap [
        rr:predicate ex:temperature;
        rr:objectMap [
            rml:reference "temp"
        ]
    ];
    
    rr:predicateObjectMap [
        rr:predicate ex:timestamp;
        rr:objectMap [
            rml:reference "timestamp"
        ]
    ] .
